# Copy to .env and edit. Every setting is optional.

# Where uploads, intermediate files and results are kept (per-job folders).
# DATA_DIR=/data   (fixed inside the container; compose mounts a volume there)
# Jobs (uploads + outputs) are deleted this many hours after upload. The answer key PDF is deleted as soon as it
# has been processed; the response sheet stays until then because review and rescoring rebuild the reordered PDF.
RETENTION_HOURS=2

# Upload limits, per file. Pages wider or taller than MAX_PAGE_INCHES are refused (A4 is 11.7 in).
MAX_FILE_MB=50
MAX_PAGES=300
MAX_PAGE_INCHES=20

# Public deployment. New uploads are refused when a client IP has made UPLOADS_PER_HOUR uploads in the last hour,
# when MAX_PENDING_JOBS jobs are already queued or processing, or when job folders use MAX_DISK_GB in total.
UPLOADS_PER_HOUR=10
MAX_PENDING_JOBS=10
MAX_DISK_GB=5

# HTTPS front end (docker compose --profile public). DOMAIN must point at this server.
# DOMAIN=checker.example.com
# Largest request Caddy accepts, in MB: 2 x MAX_FILE_MB + 1.
# MAX_REQUEST_MB=101

# OCR: render resolution and parallel Tesseract processes (defaults to the CPU count).
RENDER_DPI=200
# OCR_THREADS=2
# How many jobs may run at once.
JOB_WORKERS=1

# Matching: pairs below this text similarity, or closer than this to the runner-up, go to review.
MATCH_MIN_SCORE=0.35
MATCH_MIN_MARGIN=0.08

# Tick detection: the ticked label's ink must be TICK_RATIO x the median of the other labels
# and TICK_RUNNER_UP_RATIO x the second-highest label, or the question is marked uncertain.
TICK_RATIO=1.6
TICK_RUNNER_UP_RATIO=1.3

# Default scoring shown on the upload form.
MARKS_CORRECT=1.5
MARKS_WRONG=0

# Optional AI fallback for unclear ticks. Off unless AI_FALLBACK=1 AND a key is set.
# When used, images of the unclear answer-key questions are sent to Anthropic's API.
# On a public site every visitor can tick the box and the calls are billed to your key: leave it off.
AI_FALLBACK=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
